# deploy/pi-deploy.env.example
# The real file is ~/.pi-deploy.env on the Pi; deploy/bootstrap.sh creates it and asks for the values.
# It holds only secrets, stays on the Pi, and is never committed.

TELEGRAM_TOKEN="123456789:AAExampleToken"   # from @BotFather
TELEGRAM_CHAT_ID="123456789"                # from https://api.telegram.org/bot<TOKEN>/getUpdates
